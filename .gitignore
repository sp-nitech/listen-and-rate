.venv/
.env

results/
stimuli/*
!stimuli/examples/

# Collected ratings are data, not source. The audio is kept out too: real
# stimuli are large and usually live elsewhere, and the checked-in samples are
# regenerated by scripts/make_sample_data.py.
data/ratings/*
!data/ratings/.gitkeep
data/audio/*/*

tools/**/

.claude/
.php-cs-fixer.cache
.phpunit.result.cache
__pycache__/
\#*#
.\#*
