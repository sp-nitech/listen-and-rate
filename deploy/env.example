# Copy to the repo root as .env (that file is gitignored):
#   cp deploy/env.example .env

# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@ramsalab.ae

# bcrypt hash from:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Double every $ so Docker Compose does not treat $2a as an empty variable.
ADMIN_PASSWORD_HASH=$$2a$$14$$replace_with_output_of_caddy_hash_password
